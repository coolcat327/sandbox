version: '3.8'

services:
  sandbox:
    # 与build的image一致即可
    image: sandbox:0.1.2
    restart: always
    environment:
      # 和api镜像的API_KEY一致
      API_KEY: aioai-sandbox
      MAX_REQUESTS: 100
      MAX_WORKERS: 30
      WORKER_TIMEOUT: 60
      MAX_MEMORY_THRESHOLD: 128
    ports:
      - "8194:8194"
    command: uvicorn main:app --host 0.0.0.0 --port 8194
    #command: tail -f /dev/null